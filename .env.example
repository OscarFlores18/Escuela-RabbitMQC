# Copiar a .env y completar. NO versionar el .env real (ya esta en .gitignore).

# JWT_SECRET: clave HS256 compartida por Auth (firma el token) y Gateway (lo valida).
# Los microservicios de datos NO la necesitan: el Gateway propaga el rol.
JWT_SECRET=cambiar_por_una_clave_larga_y_aleatoria

# MYSQL_ROOT_PASSWORD: password del usuario root de MySQL.
# Debe coincidir con la del volumen mysql-data existente.
MYSQL_ROOT_PASSWORD=cambiar_por_la_password_de_mysql
